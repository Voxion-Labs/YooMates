# ==========================================
# YooMates Modern Engine Environment Configuration
# ==========================================

# Server Configuration
PORT=8080
ENV=development
APP_URL=http://localhost:8080

# Database (MySQL 8.4 / InnoDB)
DATABASE_URL=yoomates:yoomates_secret@tcp(localhost:3306)/yoomates?parseTime=true&multiStatements=true
MYSQL_ROOT_PASSWORD=yoomates_root_secret
MYSQL_USER=yoomates
MYSQL_PASSWORD=yoomates_secret
MYSQL_DATABASE=yoomates
MYSQL_PORT=3306

# Cache & Ephemeral Pub/Sub (Redis)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Object Storage (MinIO / S3 - Replaces UploadThing)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=yoomates-media
S3_USE_SSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Security & Sessions (Argon2id + Secure HTTP-only Cookie)
SESSION_SECRET=voxion_yoomates_development_secret_change_in_production
SESSION_MAX_AGE_HOURS=168

# OAuth Providers (Direct Go Handlers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
