# ==========================================
# YooMates Modern Engine Environment Configuration
# ==========================================

# Server Configuration
PORT=8080
ENV=development
APP_URL=http://localhost:8080

# Database (PostgreSQL)
DATABASE_URL=postgres://yoomates:yoomates_secret@localhost:5432/yoomates?sslmode=disable
POSTGRES_USER=yoomates
POSTGRES_PASSWORD=yoomates_secret
POSTGRES_DB=yoomates
POSTGRES_PORT=5432

# Cache & Ephemeral Pub/Sub (Redis)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Object Storage (MinIO / S3 - Replaces UploadThing)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=yoomates-media
S3_USE_SSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Security & Sessions (Argon2id + Secure HTTP-only Cookie)
SESSION_SECRET=voxion_yoomates_development_secret_change_in_production
SESSION_MAX_AGE_HOURS=168

# OAuth Providers (Direct Go Handlers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
